{
  "expo": {
    "name": "Astor Trafo Test",
    "slug": "AstorTest",
    "version": "1.2.96",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "astortest",
    "userInterfaceStyle": "automatic",
    "android": {
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.burakaydogan.AstorTest"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "./scripts/withSplitApk.js",
      "./scripts/withGradleJvmArgs.js",
      "./scripts/withCustomApkName.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9a24bef8-3401-4f38-a97b-71ea7f269ece"
      }
    },
    "owner": "darkpuye"
  }
}